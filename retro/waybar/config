{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,

    "modules-left": ["custom/start", "hyprland/workspaces", "custom/sep", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "custom/sep", "memory", "custom/sep", "pulseaudio", "custom/sep", "battery", "tray"],

    "custom/start": {
        "format": " Start",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": " < {title} > ",
        "max-length": 40
    },

    "clock": {
        "format": " {:%H:%M:%S} ",
        "interval": 1
    },

    "cpu": { "format": "CPU: {usage}%" },
    "memory": { "format": "MEM: {percentage}%" },

    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "VOL: MUTE"
    },

    "battery": {
        "format": "BAT: {capacity}%"
    },

    "custom/sep": {
        "format": " | ",
        "tooltip": false
    }
}
