{
    "layer": "top",
    "position": "left",
    "width": 30, // Más delgada
    "margin-left": 8,
    "margin-top": 8,
    "margin-bottom": 8,
    "spacing": 0,

    "modules-left": [
        "custom/logo",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/cava"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "disk",
        "backlight",
        "pulseaudio",
        "bluetooth",
        "network",
        "battery",
        "clock"
    ],

    "hyprland/workspaces": {
        "orientation": "vertical",
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "default": "•",
            "active": "󰮯"
        }
    },

    "custom/cava": {
        "exec": "cava -p ~/.config/cava/config_waybar | sed -u 's/0/ /g;s/1/▂/g;s/2/▃/g;s/3/▄/g;s/4/▅/g;s/5/▆/g;s/6/▇/g;s/7/█/g'",
        "format": "{}"
    },

    "cpu": { "format": "", "tooltip-format": "CPU: {usage}%" },
    "memory": { "format": "", "tooltip-format": "RAM: {}%" },
    "disk": { "format": "󰋊", "tooltip-format": "Disco: {percentage_used}%" },
    
    "backlight": { "format": "{icon}", "format-icons": ["", "", "", "", "", "", "", "", ""] },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol"
    },

    "bluetooth": {
        "format": "",
        "format-connected": "󰂱",
        "on-click": "blueman-manager"
    },

    "network": { "format-wifi": "󰤨", "format-disconnected": "󰤮", "tooltip-format": "{essid}" },

    "battery": { "format": "{icon}", "format-icons": ["", "", "", "", ""] },

    "clock": {
        "format": "{:%H\n%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "custom/logo": { "format": "󰣇", "tooltip": false }
}
