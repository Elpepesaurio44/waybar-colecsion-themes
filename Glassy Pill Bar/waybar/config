{
    "layer": "top",
    "position": "top",
    "spacing": 10,
    "margin-top": 2,
    "margin-left": 12,
    "margin-right": 12,
    "modules-left": ["custom/launcher", "hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["pulseaudio", "memory", "cpu", "clock", "tray", "custom/powermenu"],

    // --- MÓDULOS IZQUIERDA ---
    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -show drun",
        "tooltip": false
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "󰈹",
            "2": "󰆍",
            "3": "󰅩",
            "4": "󰎄",
            "default": "󰍹"
        },
        "persistent-workspaces": {
            "*": 4
        }
    },

    // --- MÓDULOS CENTRO ---
    "hyprland/window": {
        "format": "   {} ",
        "max-length": 30, // Aquí es donde se define el límite, no en el format
        "separate-outputs": true,
        "rewrite": {
            "": " Arch Linux "
        }
    },

    
    // --- MÓDULOS DERECHA ---
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "default": ["󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "memory": {
        "interval": 30,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "Memoria: {used:0.1f}G / {total:0.1f}G"
    },

    "cpu": {
        "interval": 10,
        "format": " {usage}%"
    },

    "clock": {
        "interval": 1,
        "format": "󰥔 {:%I:%M:%S %p}", // Equivalente a %r
        "format-alt": "󰥔 {:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/powermenu": {
        "format": "  ",
        "on-click": "~/.config/rofi/powermenu",
        "tooltip": false
    }
}
